[Unit]
Description=Проверять обновления «Успевайки» каждую ночь

[Timer]
# Ночью в 4:17 — не в круглое время: меньше шансов попасть на чужой cron
OnCalendar=*-*-* 04:17:00
# Если сервер был выключен в это время — проверить при ближайшей загрузке
Persistent=true
# Разброс до 10 минут, чтобы не бить в GitHub одновременно с другими серверами
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
