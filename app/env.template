# Шаблон настроек для продакшена.
# При установке скрипт скопирует его в .env — заполните значения.
# Никогда не коммитьте .env: в нём токен бота.

# ---------- обязательное ----------

# Токен бота от @BotFather (/newbot → скопировать токен)
BOT_TOKEN=

# HTTPS-адрес витрины — без пути и без слэша на конце.
# Пример: https://uspevaika.ru
# Telegram открывает Mini App только по https: на http кнопка меню не работает.
WEBAPP_URL=

# ---------- менеджеры ----------

# Чат, куда приходят заказы: группа с ботом.
# Узнать: добавить бота в группу, написать там /id — бот ответит chat id
# (для группы число отрицательное, например -1001234567890).
ADMIN_CHAT_ID=

# Telegram id менеджеров через запятую — им доступны кнопки статусов,
# /stock, /set, /stop, панель управления и меню менеджера.
# Свой id узнать: /id в личке с ботом.
# Этих менеджеров нельзя убрать из чата — только правкой этого файла.
ADMIN_IDS=

# Пароль для входа в /admin из браузера. НЕ обязателен: из Telegram вход идёт
# по подписанному токену, а ссылки из бота работают и в обычном браузере.
# Задайте, если хотите входить по голому адресу /admin.
ADMIN_PASSWORD=

# ---------- сеть ----------

# Порт веб-сервера (витрина + админка). Обратный прокси направляет домен сюда.
PORT=8080

# Адрес прослушивания. За nginx/Caddy на том же сервере укажите 127.0.0.1 —
# тогда порт не будет виден из интернета. Пусто = 0.0.0.0 (все интерфейсы).
BIND_HOST=

# Прокси для запросов к Telegram. aiogram сам HTTPS_PROXY не читает.
# Нужен, только если у сервера нет прямого доступа к api.telegram.org.
TELEGRAM_PROXY=

# ---------- данные (обычно не меняют) ----------

# Путь к меню; по умолчанию menu.json рядом с bot.py
MENU_PATH=

# Путь к базе заказов; по умолчанию orders.db рядом с bot.py
DB_PATH=
